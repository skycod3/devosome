# Public site URL — used for SEO metadata, sitemap and robots (absolute URLs).
# e.g. https://your-domain.com (no trailing slash). Falls back to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Weather API (WeatherAPI.com)
# Get your free key at: https://www.weatherapi.com/
# Server-side only — used by /api/weather. Do NOT prefix with NEXT_PUBLIC_,
# otherwise the key gets bundled into the client and becomes publicly visible.
WEATHER_API_KEY=your_weatherapi_key_here

# Resend (Email API)
# Get your key at: https://resend.com/
RESEND_API_KEY=your_resend_api_key_here
# Destination address for contact form submissions
RESEND_TO_EMAIL=your_email_here
